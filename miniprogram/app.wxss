/* app.wxss — 全局样式
   设计基准 390px，换算 rpx 按 1px = 2rpx 取整。
   数值全部由 src/core 算好写进 services/data.js，这里只负责排版。 */

page {
  background: #f6f1ea;
  color: #1d2026;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button { box-sizing: border-box; }

/* ================= 通用 ================= */
.pad { padding: 28rpx 32rpx 52rpx; }
.muted { color: #5f646d; font-size: 26rpx; }
.tiny { color: #9aa0a8; font-size: 23rpx; }
.num { font-variant-numeric: tabular-nums; }

.card {
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 2rpx 4rpx rgba(70, 45, 20, 0.05), 0 16rpx 48rpx rgba(70, 45, 20, 0.06);
  margin-bottom: 20rpx;
}
.card-pad { padding: 30rpx 32rpx; }
.card-h { margin: 0 0 20rpx; font-size: 28rpx; font-weight: 700; letter-spacing: 0.4rpx; }

.kv {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
}
.kv + .kv { border-top: 1rpx dashed #efe7dc; }
.kv .k { color: #5f646d; flex: 0 0 auto; }
.kv .v { text-align: right; font-weight: 600; word-break: break-all; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  vertical-align: middle;
}
.tag-green { background: #e2f5ec; color: #0f9d6c; }
.tag-gray { background: #f4f0e9; color: #5f646d; }

/* ================= 榜单页 ================= */
.storebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 32rpx 18rpx;
}
.storebar .nm {
  font-size: 26rpx;
  color: #5f646d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.livechip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e2f5ec;
  color: #0f9d6c;
  font-size: 22rpx;
  font-weight: 600;
}
.livechip .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #0f9d6c;
}
/* 数据越旧，chip 越不绿：这是「新鲜度」唯一可见的仪表 */
.livechip.aging {
  background: #fdf1dd;
  color: #b0741c;
}
.livechip.aging .dot { background: #d99a3c; }
.livechip.stale {
  background: #efe7dd;
  color: #8a7561;
}
.livechip.stale .dot { background: #a08a72; }
.livechip.unknown {
  background: #efe7dd;
  color: #8a7561;
}
.livechip.unknown .dot { background: #a08a72; }

/* 数据过期时的单行提示：只在真的旧了才出现 */
.stale-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 32rpx 16rpx;
  padding: 16rpx 22rpx;
  border-radius: 20rpx;
  background: #fdf1dd;
  color: #8a5a12;
  font-size: 24rpx;
}
.stale-tip .arw {
  flex: 0 0 auto;
  color: #c08a3a;
  font-size: 28rpx;
}

.verdict {
  padding: 0 32rpx 26rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}
.verdict .hl { color: #e8392f; }
.verdict .sub {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  font-weight: 400;
  color: #5f646d;
}

/* ---- Hero TOP1 ---- */
.hero {
  position: relative;
  overflow: hidden;
  margin: 0 32rpx 24rpx;
  border-radius: 44rpx;
  padding: 32rpx 34rpx 30rpx;
  background: linear-gradient(140deg, #ef4b36 0%, #d8202a 55%, #c81623 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(232, 57, 47, 0.3);
}
.hero .glow {
  position: absolute;
  right: -80rpx;
  top: -92rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 199, 44, 0.3), transparent 70%);
}
.hero .glow2 {
  position: absolute;
  left: -120rpx;
  bottom: -140rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.13), transparent 70%);
}
.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ffc72c;
  color: #7a4a00;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.8rpx;
}
.badge .star {
  width: 18rpx;
  height: 18rpx;
  background: #7a4a00;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.hero-deal {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1.2rpx;
  line-height: 1;
}
.hero-name {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}
.hero-comp {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-price {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-top: 24rpx;
}
.hero-price .p {
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.hero-price .d {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.72);
  text-decoration: line-through;
}
.hero-price .s {
  margin-left: auto;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 25rpx;
  font-weight: 700;
}

/* ---- 列表 ---- */
.sec-label {
  margin: 4rpx 36rpx 16rpx;
  font-size: 24rpx;
  color: #9aa0a8;
}
.row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  background: #ffffff;
  margin: 0 32rpx 18rpx;
  border-radius: 36rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(70, 45, 20, 0.05), 0 16rpx 48rpx rgba(70, 45, 20, 0.06);
}
.row .rk {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  background: #f4f0e9;
  color: #5f646d;
}
.row .rk.top2 { background: #ffe6cb; color: #a35b00; }
.row .rk.top3 { background: #fff0c8; color: #8a6100; }
.row .mid { flex: 1; min-width: 0; }
.row .nm {
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.row .cmp {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9aa0a8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.row .deal {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #fdeae6;
  color: #e8392f;
  font-size: 24rpx;
  font-weight: 700;
}
.row .right { flex: 0 0 auto; text-align: right; }
.row .p1 {
  font-size: 40rpx;
  font-weight: 800;
  color: #e8392f;
  letter-spacing: -1rpx;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.row .p2 {
  font-size: 22rpx;
  color: #9aa0a8;
  text-decoration: line-through;
  margin-top: 2rpx;
}

/* ---- 未上榜 ---- */
.off {
  margin: 32rpx 32rpx 12rpx;
  background: #ffffff;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(70, 45, 20, 0.05), 0 16rpx 48rpx rgba(70, 45, 20, 0.06);
}
.off-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 30rpx;
}
.off-head .t { font-size: 26rpx; font-weight: 600; }
.off-head .t .hint {
  font-weight: 400;
  color: #9aa0a8;
  font-size: 23rpx;
  margin-left: 10rpx;
}
.chev {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f4f0e9;
  color: #9aa0a8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  transform: rotate(0deg);
  transition: transform 0.24s cubic-bezier(0.34, 1.4, 0.64, 1);
}
.chev.open { transform: rotate(90deg); }
.off-note {
  padding: 24rpx 30rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #5f646d;
  background: #f4f0e9;
  border-top: 1rpx solid #efe7dc;
  border-bottom: 1rpx solid #efe7dc;
}
.off-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 30rpx;
  border-top: 1rpx solid #efe7dc;
}
.off-item .n { font-size: 28rpx; font-weight: 600; }
.off-item .w { font-size: 23rpx; color: #9aa0a8; margin-top: 4rpx; }
.off-price {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  color: #9aa0a8;
  font-variant-numeric: tabular-nums;
}
.off-price .arw { color: #c8beb0; font-size: 26rpx; }

.foot-note {
  text-align: center;
  padding: 28rpx 48rpx 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #9aa0a8;
}

/* ================= 详情页 ================= */
.dt-head { padding: 36rpx 32rpx 28rpx; }
.dt-name { font-size: 44rpx; font-weight: 800; line-height: 1.3; }
.dt-sub { margin-top: 10rpx; font-size: 25rpx; color: #5f646d; }
.dt-big {
  margin-top: 28rpx;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.dt-big .p {
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -2.8rpx;
  color: #e8392f;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.dt-big .d { font-size: 26rpx; color: #9aa0a8; text-decoration: line-through; }
.dt-big .pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fdeae6;
  color: #e8392f;
  font-size: 26rpx;
  font-weight: 800;
}

.formula {
  background: #f4f0e9;
  border-radius: 26rpx;
  padding: 26rpx 28rpx;
  text-align: center;
}
.formula .eq { font-size: 30rpx; font-weight: 600; }
.formula .eq .hl { color: #e8392f; font-size: 36rpx; font-weight: 800; margin-left: 6rpx; }
.formula .why {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9aa0a8;
}

.comp {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
}
.comp + .comp { border-top: 1rpx dashed #efe7dc; }
.comp .l { flex: 1; min-width: 0; }
.comp .l .t { font-weight: 600; }
.comp .l .q { font-size: 24rpx; font-weight: 400; color: #9aa0a8; margin-left: 6rpx; }
.comp .l .x { font-size: 22rpx; color: #9aa0a8; margin-top: 4rpx; }
.comp .r { flex: 0 0 auto; text-align: right; font-size: 26rpx; }
.comp .r .u { font-weight: 600; font-variant-numeric: tabular-nums; }
.comp .r .s { font-size: 22rpx; color: #9aa0a8; margin-top: 2rpx; font-variant-numeric: tabular-nums; }
.comp .r .un { color: #9aa0a8; font-size: 24rpx; }

.total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
  padding-top: 24rpx;
  border-top: 3rpx solid #1d2026;
  font-size: 28rpx;
  font-weight: 700;
}
.total .v { font-size: 36rpx; font-variant-numeric: tabular-nums; }

.fold {
  background: #ffffff;
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(70, 45, 20, 0.05), 0 16rpx 48rpx rgba(70, 45, 20, 0.06);
}
.fold-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 32rpx;
}
.fold-head .t { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 600; }
.fold-head .hint {
  font-size: 23rpx;
  color: #9aa0a8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fold-body { padding: 4rpx 32rpx 28rpx; border-top: 1rpx solid #efe7dc; }

/* ================= 数据来源页 ================= */
.src-hero {
  margin: 0 32rpx 24rpx;
  padding: 36rpx 34rpx;
  border-radius: 44rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  background: linear-gradient(140deg, #2c3038, #1a1d22);
}
.src-hero .glow {
  position: absolute;
  right: -100rpx;
  top: -100rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 199, 44, 0.26), transparent 70%);
}
.src-hero .h2 {
  position: relative;
  z-index: 1;
  font-size: 38rpx;
  font-weight: 800;
}
.src-hero .p {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.8);
}

.pill-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
}
.pill {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(70, 45, 20, 0.05), 0 8rpx 24rpx rgba(70, 45, 20, 0.06);
  font-size: 24rpx;
  font-weight: 600;
  color: #5f646d;
}
.pill .b { color: #e8392f; font-weight: 800; }

.devrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
}
.devrow + .devrow { border-top: 1rpx dashed #efe7dc; }
.devrow .l { flex: 1; min-width: 0; }
.devrow .l .n {
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.devrow .l .s {
  font-size: 22rpx;
  color: #5f646d;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}
.devrow .pct {
  flex: 0 0 auto;
  font-size: 25rpx;
  font-weight: 800;
  color: #0f9d6c;
  font-variant-numeric: tabular-nums;
}
.devrow .pct.warn { color: #d98324; }

/* ================= 空态 ================= */
.empty { text-align: center; padding: 100rpx 60rpx; }
.empty .art { width: 192rpx; margin: 0 auto 32rpx; }
.empty .bun { height: 48rpx; border-radius: 100rpx 100rpx 16rpx 16rpx; background: #ffe3a3; border: 4rpx solid #e8b23a; margin: 0 18rpx; }
.empty .patty { height: 24rpx; border-radius: 10rpx; background: #f6c453; border: 4rpx solid #e8b23a; margin: 8rpx 0; }
.empty .let { height: 20rpx; border-radius: 10rpx; background: #ef8a3c; border: 4rpx solid #e07840; }
.empty .base { height: 44rpx; border-radius: 16rpx 16rpx 100rpx 100rpx; background: #ffe3a3; border: 4rpx solid #e8b23a; margin: 8rpx 18rpx 0; }
.empty .big { font-size: 32rpx; font-weight: 700; margin-bottom: 10rpx; }
.empty .sub { font-size: 26rpx; color: #5f646d; }
