<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'on' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="icon {{item.icon}} {{selected === index ? 'on' : ''}}"></view>
    <view class="label">{{item.text}}</view>
  </view>
</view>
