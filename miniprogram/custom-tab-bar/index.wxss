.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid rgba(210, 196, 178, 0.55);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 8rpx 14rpx;
}

.icon {
  width: 46rpx;
  height: 46rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.label {
  font-size: 21rpx;
  color: #9aa0a8;
  line-height: 1.3;
}

.tab.on .label {
  color: #e8392f;
  font-weight: 600;
}

/* 列表图标 */
.icon.list {
  background-image: url("data:image/svg+xml;base64,");
}
.icon.list.on {
  background-image: url("data:image/svg+xml;base64,");
}

/* 数据库图标 */
.icon.db {
  background-image: url("data:image/svg+xml;base64,");
}
