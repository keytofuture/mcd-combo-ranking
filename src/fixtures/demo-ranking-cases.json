{
  "mode": "demo",
  "note": "排名场景（PRD A14）。显示折数相同不代表名次相同；名次按未舍入比值。",
  "cases": [
    {
      "id": "A14",
      "title": "同比例同名次；0.601 与 0.604 显示同为 6.0 折但按真比值排序",
      "items": [
        { "id": "combo-a", "P": 600, "D": 1000 },
        { "id": "combo-b", "P": 1200, "D": 2000 },
        { "id": "combo-c", "P": 601, "D": 1000 },
        { "id": "combo-d", "P": 604, "D": 1000 }
      ],
      "expected": {
        "order": ["combo-b", "combo-a", "combo-c", "combo-d"],
        "ranks": [1, 1, 3, 4],
        "discountTexts": ["6.0折", "6.0折", "6.0折", "6.0折"]
      }
    },
    {
      "id": "A14-tie3",
      "title": "三个并列第一，随后跳号到第 4 名",
      "items": [
        { "id": "c1", "P": 500, "D": 1000 },
        { "id": "c2", "P": 1000, "D": 2000 },
        { "id": "c3", "P": 1500, "D": 3000 },
        { "id": "c4", "P": 800, "D": 1000 }
      ],
      "expected": {
        "ranks": [1, 1, 1, 4]
      }
    },
    {
      "id": "A14-tie-order",
      "title": "同名次内展示顺序：A 降序 -> P 升序 -> 稳定标识升序",
      "items": [
        { "id": "z-last", "P": 500, "D": 1000 },
        { "id": "a-first", "P": 500, "D": 1000 },
        { "id": "m-mid", "P": 500, "D": 1000 }
      ],
      "expected": {
        "order": ["a-first", "m-mid", "z-last"],
        "ranks": [1, 1, 1]
      }
    }
  ]
}
